# Training artifacts & logs (stay on WSL side, never in repo)
saves/
logs/
*.log

# Data files (raw datasets & generated artifacts, never in repo)
data/raw/*
data/interim/*
data/sft/*
data/rl/*
data/eval/*
data/cpt/*
