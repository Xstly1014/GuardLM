# Personal files (never push)
*.pdf
!paper/figures/*.pdf
!paper/main.pdf

# Internal development docs (kept local, not part of the open-source repo)
docs/

# Paper tooling (tectonic binary); figures PDFs are re-included below
paper/tools/

# Tooling
.trae/
.vscode/
__pycache__/
*.pyc
*.egg-info/

# Secrets (API keys, never push)
configs/*.env

# OS
Thumbs.db
.DS_Store
